# Copy this file to .env (which is gitignored) and fill in real values.
# Used ONLY by scripts/get-refresh-token.js, run locally once to produce a
# GOOGLE_REFRESH_TOKEN — these two values also need to be set as real Vercel
# environment variables (Project → Settings → Environment Variables), not
# just here. See SETUP.md.

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
